---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects } from "../../lib/content";

const projects = (await getProjects()).filter((project) => project.id === "personal-blog-system");
---

<BaseLayout title="项目" description="正在构建、探索和持续打磨的作品集项目。">
  <section class="mx-auto w-full max-w-6xl px-5 py-12 sm:px-8">
    <header class="mb-8 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">项目</p>
      <h1 class="mt-3 text-4xl font-black text-slate-950 sm:text-5xl">正在打磨的作品</h1>
      <p class="mt-4 text-lg leading-8 text-slate-600">一些已经做出来、正在验证，或者暂时停在原型阶段的小产品。</p>
    </header>
    {projects.length > 0 ? (
      <div class="grid gap-4 md:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    ) : (
      <p class="rounded-lg border border-slate-200 bg-white p-5 text-slate-600">暂时还没有发布项目。</p>
    )}
  </section>
</BaseLayout>
