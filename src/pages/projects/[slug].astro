---
import { getCollection, render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import TagList from "../../components/TagList.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter((project) => project.id === "personal-blog-system");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const hasProjectLinks = Boolean(project.data.demoUrl || project.data.repoUrl);
const coverAlt = `${project.data.title}预览`;
---

<ContentLayout
  title={project.data.title}
  description={project.data.description}
  date={project.data.date}
  tags={project.data.tags}
  backHref="/projects/"
  backLabel="返回项目"
>
  {
    project.data.cover && (
      <img
        class="mb-8 aspect-[16/10] w-full rounded-lg border border-slate-200 object-cover shadow-sm"
        src={project.data.cover}
        alt={coverAlt}
      />
    )
  }
  <aside aria-label="项目详情" class="mb-8 rounded-lg border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm font-semibold text-slate-950">状态：{project.data.status}</p>
    {project.data.stack.length > 0 && (
      <div class="mt-4">
        <TagList tags={project.data.stack} />
      </div>
    )}
    {hasProjectLinks && (
      <div class="mt-5 flex flex-wrap gap-3 text-sm font-semibold">
        {
          project.data.demoUrl && (
            <a class="text-blue-600 hover:text-blue-800" href={project.data.demoUrl} aria-label={`查看${project.data.title}演示`}>
              演示
            </a>
          )
        }
        {
          project.data.repoUrl && (
            <a class="text-blue-600 hover:text-blue-800" href={project.data.repoUrl} aria-label={`查看${project.data.title}代码仓库`}>
              代码
            </a>
          )
        }
      </div>
    )}
  </aside>
  <Content />
</ContentLayout>
