---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getDailyNotes } from "../../lib/content";

const notes = await getDailyNotes();
---

<BaseLayout title="日常" description="一些更接近生活现场的短记录：修了什么、读到什么、今天为什么停下来。">
  <section class="mx-auto w-full max-w-5xl px-5 py-12 sm:px-8">
    <header class="mb-8 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">日常</p>
      <h1 class="mt-3 text-4xl font-black text-slate-950 sm:text-5xl">生活和开发之间的小记录</h1>
      <p class="mt-4 text-lg leading-8 text-slate-600">不一定完整，也不一定宏大。这里放一些更靠近日常的片段，让网站不只剩下项目和技术结论。</p>
    </header>
    {notes.length > 0 ? (
      <div class="grid gap-4">
        {notes.map((note) => (
          <ContentCard
            href={`/notes/${note.id}/`}
            title={note.data.title}
            description={note.data.description}
            date={note.data.date}
            tags={note.data.tags}
            type="日常"
          />
        ))}
      </div>
    ) : (
      <p class="rounded-lg border border-slate-200 bg-white p-5 text-slate-600">暂时还没有日常记录。</p>
    )}
  </section>
</BaseLayout>
