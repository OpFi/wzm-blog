const sortedEntries = [...dailyEntries].sort((a, b) => b.date.localeCompare(a.date));
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: "UTC",
});
const monthFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  timeZone: "UTC",
});
const newestDate = new Date(`${sortedEntries[0].date}T00:00:00Z`);
const newestMonthLabel = monthFormatter.format(newestDate);
const tagOrder = ["美食", "出行", "日常", "记录", "运动"];
const tagCounts = tagOrder.map((tag) => ({
  tag,
  count: sortedEntries.filter((entry) => entry.tags.includes(tag)).length,
}));
const monthGroups = new Map<string, DailyEntry[]>();
const yearMap = new Map<string, Set<string>>();

for (const entry of sortedEntries) {
  const date = new Date(`${entry.date}T00:00:00Z`);
  const year = String(date.getUTCFullYear());
  const month = String(date.getUTCMonth() + 1).padStart(2, "0");
  const monthKey = `${year}-${month}`;

  monthGroups.set(monthKey, [...(monthGroups.get(monthKey) ?? []), entry]);

  if (!yearMap.has(year)) {
    yearMap.set(year, new Set());
  }

  yearMap.get(year)?.add(month);
}

const years = [...yearMap.entries()].map(([year, months]) => ({
  year,
  months: [...months].sort((a, b) => Number(b) - Number(a)),
}));
const groups = [...monthGroups.entries()].map(([monthKey, entries]) => {
  const [year, month] = monthKey.split("-");
  const date = new Date(`${monthKey}-01T00:00:00Z`);

  return {
    id: `daily-${monthKey}`,
    year,
    month,
    label: monthFormatter.format(date),
    entries,
  };
});
---

<BaseLayout title="日常" description="小志的生活碎片、美食、出行、运动和日常记录。">
  <section class="daily-page" data-daily-root>
    <div class="daily-shell">
      <aside class="daily-month-nav" data-month-nav aria-label="年月导航">
        {years.map(({ year, months }, yearIndex) => (
          <section class:list={["year-section", yearIndex === 0 && "is-active"]} data-year-section={year}>
            <h2>
              <a class="year-link" href={`#daily-${year}-${months[0]}`}>{year}年</a>
            </h2>
            <div class="month-list" data-year-months={year}>
              {months.map((month) => (
                <a href={`#daily-${year}-${month}`}>{Number(month)}月</a>
              ))}
            </div>
          </section>
        ))}
      </aside>

      <main class="daily-main" aria-label="日常时间线">
        <header class="daily-hero">
          <h1>小志的点滴</h1>
          <p>{newestMonthLabel}</p>
          <span>ATMOSPHERIC CHRONOLOGY</span>
        </header>

        <div class="timeline">
          {groups.map((group) => (
            <section class="timeline-month" id={group.id} data-daily-month data-month-year={group.year}>
              <h2>{group.label}</h2>
              <div class="timeline-cards">
                {group.entries.map((entry) => (
                  <article class="daily-card" data-daily-card data-daily-tag={entry.tags.join("|")}>
                    <div class="timeline-dot" aria-hidden="true"></div>
                    <div class="daily-card-inner">
                      <h3>{entry.title}</h3>
                      <div class="daily-body">
                        {entry.body.map((line) => (
                          <p>{line}</p>
                        ))}
                      </div>
                      {entry.images.length > 0 && (
                        <div class:list={["daily-images", entry.images.length > 1 && "is-grid"]}>
                          {entry.images.map((image, imageIndex) => (
                            <img src={image} alt={`${entry.title}配图 ${imageIndex + 1}`} loading="lazy" />
                          ))}
                        </div>
                      )}
                      <div class="daily-card-meta">
                        <time datetime={entry.date}>{dateFormatter.format(new Date(`${entry.date}T00:00:00Z`))}</time>
                        <span>{entry.tags[0]}</span>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
          <p class="daily-empty" data-daily-empty hidden>这个标签下暂时没有记录。</p>
        </div>
      </main>

      <aside class="daily-filter-panel" aria-label="标签筛选">
        <div class="tag-filter-list">
          <button class="is-active" type="button" data-daily-filter="全部" aria-pressed="true">
            <span>全部</span>
            <strong>{sortedEntries.length}</strong>
          </button>
          {tagCounts.map(({ tag, count }) => (
            <button type="button" data-daily-filter={tag} aria-pressed="false">
              <span>{tag}</span>
              <strong>{count}</strong>
            </button>
          ))}
        </div>
        <div class="life-note">
          <strong>LIFE'S NOTE</strong>
          <p>这里充满了小志的日常碎碎念，也放一些刚好照亮当天的小事。</p>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    const dailyRoot = document.querySelector("[data-daily-root]");

    if (dailyRoot) {
      const filterButtons = [...dailyRoot.querySelectorAll("[data-daily-filter]")];
      const cards = [...dailyRoot.querySelectorAll("[data-daily-card]")];
      const monthGroups = [...dailyRoot.querySelectorAll("[data-daily-month]")];
      const yearSections = [...dailyRoot.querySelectorAll("[data-year-section]")];
      const emptyState = dailyRoot.querySelector("[data-daily-empty]");

      function updateActiveDailyYear(activeYear) {
        for (const section of yearSections) {
          const isActive = section.getAttribute("data-year-section") === activeYear;
          section.classList.toggle("is-active", isActive);
        }
      }

      function syncActiveDailyYear() {
        const visibleGroups = monthGroups.filter((group) => !group.hidden);
        const viewportAnchor = window.innerHeight * 0.28;
        let activeGroup = visibleGroups[0];

        for (const group of visibleGroups) {
          const rect = group.getBoundingClientRect();

          if (rect.top <= viewportAnchor) {
            activeGroup = group;
          }
        }

        if (activeGroup) {
          updateActiveDailyYear(activeGroup.getAttribute("data-month-year") ?? "");
        }
      }

      function applyDailyFilter(activeTag) {
        let visibleCount = 0;

        for (const card of cards) {
          const tags = card.getAttribute("data-daily-tag") ?? "";
          const isVisible = activeTag === "全部" || tags.split("|").includes(activeTag);

          card.hidden = !isVisible;
          if (isVisible) {
            visibleCount += 1;
          }
        }

        for (const group of monthGroups) {
          const visibleCards = [...group.querySelectorAll("[data-daily-card]")].some((card) => !card.hidden);
          group.hidden = !visibleCards;
        }

        for (const button of filterButtons) {
          const isActive = button.getAttribute("data-daily-filter") === activeTag;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        }

        if (emptyState) {
          emptyState.hidden = visibleCount > 0;
        }

        syncActiveDailyYear();
      }

      for (const button of filterButtons) {
        button.addEventListener("click", () => {
          applyDailyFilter(button.getAttribute("data-daily-filter") ?? "全部");
        });
      }

      const monthObserver = new IntersectionObserver(
        (entries) => {
          const visibleEntry = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => Math.abs(a.boundingClientRect.top) - Math.abs(b.boundingClientRect.top))[0];

          if (visibleEntry) {
            updateActiveDailyYear(visibleEntry.target.getAttribute("data-month-year") ?? "");
          }
        },
        {
          rootMargin: "-18% 0px -62% 0px",
          threshold: 0.01,
        },
      );

      for (const group of monthGroups) {
        monthObserver.observe(group);
      }

      window.addEventListener("scroll", syncActiveDailyYear, { passive: true });
      syncActiveDailyYear();
    }
  </script>

  <style>
    .daily-page {
      min-height: 100%;
      background:
        linear-gradient(180deg, rgba(247, 252, 244, 0.96), rgba(254, 251, 244, 0.82)),
        radial-gradient(circle at 12% 0%, rgba(187, 247, 208, 0.36), transparent 34%),
        var(--paper);
      color: #214232;
      padding: 2rem clamp(3rem, 5vw, 5rem) 4.5rem;
    }

    .daily-shell {
      display: grid;
      grid-template-columns: 12rem minmax(0, 1fr) 15rem;
      gap: clamp(1.35rem, 2.6vw, 2.8rem);
      width: min(100%, 80rem);
      margin: 0 auto;
      align-items: start;
    }

    .daily-month-nav,
    .daily-filter-panel {
      position: sticky;
      top: 1rem;
    }

    .daily-month-nav {
      display: grid;
      gap: 1.28rem;
      padding-top: 1rem;
    }

    .year-section {
      opacity: 0.68;
      transition: opacity 180ms ease;
    }

    .year-section.is-active {
      opacity: 1;
    }

    .daily-month-nav h2 {
      margin: 0;
      line-height: 1;
    }

    .year-link {
      color: #14532d;
      font-size: 1.32rem;
      font-weight: 900;
      transition: color 180ms ease;
    }

    .year-link:hover {
      color: #047857;
    }

    .month-list {
      display: grid;
      gap: 0.78rem;
      margin-top: 0;
      padding-left: 0.92rem;
      border-left: 2px solid rgba(20, 83, 45, 0.18);
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        max-height 220ms ease,
        opacity 180ms ease,
        margin-top 180ms ease;
    }

    .year-section.is-active .month-list {
      margin-top: 0.82rem;
      max-height: 14rem;
      opacity: 1;
    }

    .month-list a {
      color: rgba(33, 66, 50, 0.58);
      font-size: 0.94rem;
      font-weight: 700;
      transition:
        color 180ms ease,
        transform 180ms ease;
    }

    .month-list a:hover {
      color: #047857;
      transform: translateX(2px);
    }

    .year-section.is-active .month-list a:first-child {
      color: #047857;
    }

    .daily-hero {
      margin-bottom: 1.55rem;
      text-align: center;
    }

    .daily-hero h1 {
      margin: 0;
      color: #14532d;
      font-size: clamp(2.05rem, 4vw, 3.15rem);
      font-weight: 950;
      letter-spacing: 0;
      line-height: 1.05;
    }

    .daily-hero p {
      margin: 0.88rem 0 0;
      color: #254b37;
      font-size: clamp(1.95rem, 4.6vw, 3rem);
      font-weight: 800;
      letter-spacing: 0;
      line-height: 1;
    }

    .daily-hero span {
      display: block;
      margin-top: 0.9rem;
      color: rgba(33, 66, 50, 0.58);
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.34em;
    }

    .timeline {
      position: relative;
      padding-left: 2.4rem;
    }

    .timeline::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0.6rem;
      width: 2px;
      background: linear-gradient(180deg, #14532d, rgba(20, 83, 45, 0.2));
    }

    .timeline-month {
      scroll-margin-top: 1rem;
    }

    .timeline-month + .timeline-month {
      margin-top: 1.4rem;
    }

    .timeline-month h2 {
      margin: 0 0 1rem;
      color: rgba(33, 66, 50, 0.74);
      font-size: 1.08rem;
      font-weight: 850;
      letter-spacing: 0;
    }

    .timeline-cards {
      display: grid;
      gap: 1rem;
    }

    .daily-card {
      position: relative;
    }

    .daily-card[hidden],
    .timeline-month[hidden],
    .daily-empty[hidden] {
      display: none;
    }

    .timeline-dot {
      position: absolute;
      top: 2rem;
      left: -2.12rem;
      width: 0.72rem;
      aspect-ratio: 1;
      border-radius: 999px;
      background: #14532d;
      box-shadow: 0 0 0 5px rgba(220, 252, 231, 0.9);
    }

    .daily-card-inner {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(21, 128, 61, 0.14);
      border-radius: 12px;
      background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(249, 253, 247, 0.9)),
        #fff;
      box-shadow: 0 18px 42px rgba(20, 83, 45, 0.08);
      padding: clamp(1.1rem, 2vw, 1.55rem);
    }

    .daily-card-inner h3 {
      margin: 0;
      color: #166534;
      font-size: clamp(1.12rem, 1.8vw, 1.42rem);
      font-weight: 900;
      line-height: 1.2;
    }

    .daily-body {
      margin-top: 0.66rem;
      color: #254b37;
      font-size: 0.9rem;
      line-height: 1.76;
    }

    .daily-body p {
      margin: 0;
    }

    .daily-body p + p {
      margin-top: 0.18rem;
    }

    .daily-images {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 11rem));
      gap: 0.7rem;
      margin-top: 1rem;
    }

    .daily-images:not(.is-grid) {
      grid-template-columns: minmax(0, 17rem);
    }

    .daily-images img {
      width: 100%;
      aspect-ratio: 4 / 3;
      border: 1px solid rgba(21, 128, 61, 0.16);
      border-radius: 10px;
      object-fit: cover;
      background: #f7fff2;
    }

    .daily-card-meta {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 1.2rem;
    }

    .daily-card-meta time {
      color: rgba(33, 66, 50, 0.55);
      font-size: 0.76rem;
      font-weight: 650;
    }

    .daily-card-meta span {
      border-radius: 6px;
      background: #15803d;
      color: #ffffff;
      padding: 0.18rem 0.5rem;
      font-size: 0.7rem;
      font-weight: 800;
    }

    .daily-filter-panel {
      display: grid;
      gap: 1rem;
      padding-top: 1rem;
      border: 1px solid rgba(21, 128, 61, 0.16);
      border-radius: 12px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(247, 253, 248, 0.9)),
        #ffffff;
      box-shadow: 0 18px 42px rgba(20, 83, 45, 0.08);
      padding: 1rem;
    }

    .tag-filter-list {
      display: grid;
      gap: 0.55rem;
    }

    .tag-filter-list button {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 1rem;
      border: 0;
      border-radius: 12px;
      background: transparent;
      color: #557264;
      cursor: pointer;
      font: inherit;
      padding: 0.68rem 0.86rem;
      text-align: left;
      transition:
        background-color 180ms ease,
        color 180ms ease,
        transform 180ms ease;
    }

    .tag-filter-list button:hover {
      background: rgba(220, 252, 231, 0.54);
      color: #14532d;
      transform: translateX(-2px);
    }

    .tag-filter-list button.is-active {
      background: #15803d;
      color: #ffffff;
      box-shadow: 0 14px 30px rgba(21, 128, 61, 0.2);
    }

    .tag-filter-list span {
      font-size: 0.9rem;
      font-weight: 800;
    }

    .tag-filter-list strong {
      font-size: 0.82rem;
      font-weight: 800;
    }

    .life-note {
      border-radius: 12px;
      background:
        linear-gradient(145deg, rgba(236, 253, 245, 0.9), rgba(241, 248, 234, 0.9)),
        #ecfdf5;
      padding: 0.96rem;
      color: #557264;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
    }

    .life-note strong {
      display: block;
      color: #14532d;
      font-size: 0.74rem;
      font-weight: 900;
      letter-spacing: 0.16em;
    }

    .life-note p {
      margin: 0.65rem 0 0;
      font-size: 0.82rem;
      line-height: 1.75;
    }

    .daily-empty {
      margin: 0;
      border: 1px solid rgba(21, 128, 61, 0.14);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.9);
      padding: 1rem 1.2rem;
      color: #557264;
    }

    @media (max-width: 1100px) {
      .daily-shell {
        grid-template-columns: minmax(0, 1fr) 15rem;
      }

      .daily-month-nav {
        position: static;
        grid-column: 1 / -1;
        display: flex;
        gap: 1.2rem;
        overflow-x: auto;
        padding-bottom: 0.4rem;
      }

      .daily-month-nav section {
        min-width: 8rem;
      }
    }

    @media (max-width: 780px) {
      .daily-page {
        padding-inline: 0.95rem;
      }

      .daily-shell {
        grid-template-columns: 1fr;
      }

      .daily-filter-panel {
        position: static;
        order: -1;
      }

      .tag-filter-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .timeline {
        padding-left: 1.7rem;
      }

      .timeline::before {
        left: 0.45rem;
      }

      .timeline-dot {
        left: -1.62rem;
      }
    }

    @media (max-width: 520px) {
      .daily-hero {
        text-align: left;
      }

      .tag-filter-list {
        grid-template-columns: 1fr;
      }

      .daily-images,
      .daily-images:not(.is-grid) {
        grid-template-columns: 1fr;
