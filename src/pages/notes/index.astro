---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getPublishedNotes } from "../../lib/content";

const notes = await getPublishedNotes();
---

<BaseLayout title="随笔" description="短更新、阅读片段、开发观察和不必展开成文章的小想法。">
  <section class="mx-auto w-full max-w-5xl px-5 py-12 sm:px-8">
    <header class="mb-8 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">随笔</p>
      <h1 class="mt-3 text-4xl font-black text-slate-950 sm:text-5xl">短一点的观察</h1>
      <p class="mt-4 text-lg leading-8 text-slate-600">开发过程中的小更新、阅读摘录、界面文案和还没长成文章的想法。</p>
    </header>
    {notes.length > 0 ? (
      <div class="grid gap-4">
        {notes.map((note) => (
          <ContentCard
            href={`/notes/${note.id}/`}
            title={note.data.title}
            description={note.data.description}
            date={note.data.date}
            tags={note.data.tags}
            type="随记"
          />
        ))}
      </div>
    ) : (
      <p class="rounded-lg border border-slate-200 bg-white p-5 text-slate-600">暂时还没有发布随记。</p>
    )}
  </section>
</BaseLayout>
