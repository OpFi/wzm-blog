---
import ArticleIndexPage from "../../components/ArticleIndexPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedNotes } from "../../lib/content";

const notes = await getPublishedNotes();
const items = notes.map((note) => ({
  href: `/notes/${note.id}/`,
  title: note.data.title,
  description: note.data.description,
  date: note.data.date,
  tags: note.data.tags,
  type: "随记",
}));
---

<BaseLayout title="随笔" description="短更新、阅读片段、开发观察和不必展开成文章的小想法。">
  <ArticleIndexPage
    eyebrow="NOTES"
    title="短一点的观察"
    description="开发过程中的小更新、阅读摘录、界面文案和还没长成文章的想法。"
    items={items}
    emptyText="暂时还没有发布随记。"
    listAriaLabel="随笔列表"
    filterAriaLabel="随笔筛选"
    searchPlaceholder="搜索随笔"
    dataNamespace="notes"
  />
</BaseLayout>
