---
import ArticleIndexPage from "../../components/ArticleIndexPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedWriting } from "../../lib/content";

const posts = await getPublishedWriting();
const items = posts.map((post) => ({
  href: `/writing/${post.id}/`,
  title: post.data.title,
  description: post.data.description,
  date: post.data.date,
  tags: post.data.tags,
  type: "文章",
}));
---

<BaseLayout title="技术" description="技术写作、产品复盘和长期整理的实践文章。">
  <ArticleIndexPage
    eyebrow="TECH WRITING"
    title="完整一点的技术思考"
    description="技术实现、产品取舍、上线记录，以及一些整理后仍然值得留下来的复盘。"
    items={items}
    emptyText="暂时还没有发布文章。"
    listAriaLabel="技术文章列表"
    filterAriaLabel="技术文章筛选"
    searchPlaceholder="搜索文章"
    dataNamespace="writing"
  />
</BaseLayout>
