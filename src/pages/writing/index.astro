---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getPublishedWriting } from "../../lib/content";

const posts = await getPublishedWriting();
---

<BaseLayout title="文章" description="技术写作、产品复盘和长期整理的实践文章。">
  <section class="mx-auto w-full max-w-5xl px-5 py-12 sm:px-8">
    <header class="mb-8 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">文章</p>
      <h1 class="mt-3 text-4xl font-black text-slate-950 sm:text-5xl">完整一点的思考</h1>
      <p class="mt-4 text-lg leading-8 text-slate-600">技术实现、产品取舍、上线记录，以及一些整理后仍然值得留下来的复盘。</p>
    </header>
    {posts.length > 0 ? (
      <div class="grid gap-4">
        {posts.map((post) => (
          <ContentCard
            href={`/writing/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
            type="文章"
          />
        ))}
      </div>
    ) : (
      <p class="rounded-lg border border-slate-200 bg-white p-5 text-slate-600">暂时还没有发布文章。</p>
    )}
  </section>
</BaseLayout>
