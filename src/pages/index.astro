---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import StatusPanel from "../components/StatusPanel.astro";
import { formatDate, getFeaturedProject, getLatestUpdates } from "../lib/content";

const featuredProject = await getFeaturedProject();
const latestUpdates = await getLatestUpdates(6);
const categories = [
  { href: "/writing/", label: "技术", description: "实现记录、工具链、部署和工程取舍。" },
  { href: "/notes/", label: "随笔", description: "还没有展开成文章的观察和片段。" },
  { href: "/daily/", label: "日常", description: "更靠近生活现场的小记录。" },
  { href: "/projects/", label: "项目", description: "正在打磨或已经完成的作品。" },
];
---

<BaseLayout>
  <section class="border-y border-slate-200 bg-[linear-gradient(135deg,rgba(248,250,252,0.96),rgba(239,246,255,0.88)_48%,rgba(240,253,244,0.86))]">
    <div class="mx-auto grid w-full max-w-6xl gap-8 px-5 py-14 sm:px-8 sm:py-16 lg:grid-cols-[1fr_22rem]">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">个人博客 / 技术写作 / 日常记录</p>
        <h1 class="mt-4 font-serif text-4xl font-black leading-tight text-slate-950 sm:text-6xl">
          写代码，也写下代码背后的生活。
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-700">
          我是王子明。这里放技术实现、产品取舍、个人项目和一些日常片段。它不急着成为一本完整的书，更像一张持续更新的工作桌。
        </p>
        <div class="mt-8 flex flex-wrap gap-3 text-sm font-semibold">
          <a class="rounded-full bg-slate-950 px-4 py-2 text-white transition hover:bg-slate-800" href="/writing/">读技术文章</a>
          <a class="rounded-full border border-slate-300 bg-white/70 px-4 py-2 text-slate-800 transition hover:border-slate-500" href="/daily/">看日常记录</a>
          <a class="rounded-full border border-slate-300 bg-white/70 px-4 py-2 text-slate-800 transition hover:border-slate-500" href="/about/">关于我</a>
        </div>
      </div>
      <StatusPanel />
    </div>
  </section>

  <section class="bg-white/80 px-5 py-12 sm:px-8">
    <div class="mx-auto grid w-full max-w-6xl gap-10 lg:grid-cols-[1fr_20rem]">
      <div>
        <div class="mb-6">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">最新更新</p>
          <h2 class="mt-2 text-3xl font-black text-slate-950">最近写下的东西</h2>
        </div>
        <div class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white shadow-sm">
          {latestUpdates.map((update) => (
            <a class="block px-5 py-5 transition hover:bg-slate-50" href={update.href}>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
                <p class="text-sm font-semibold text-slate-500">{update.type}</p>
                <time class="text-xs text-slate-500" datetime={update.entry.data.date.toISOString()}>{formatDate(update.entry.data.date)}</time>
              </div>
              <h3 class="mt-2 text-xl font-bold leading-tight text-slate-950">{update.entry.data.title}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">{update.entry.data.description}</p>
            </a>
          ))}
        </div>
      </div>

      <aside class="grid gap-5">
        <section>
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">分类索引</p>
          <div class="mt-3 grid gap-3">
            {categories.map((category) => (
              <a class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md" href={category.href}>
                <h2 class="text-lg font-bold text-slate-950">{category.label}</h2>
                <p class="mt-2 text-sm leading-6 text-slate-600">{category.description}</p>
              </a>
            ))}
          </div>
        </section>
        {featuredProject && (
          <section>
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">正在做</p>
            <ProjectCard project={featuredProject} />
          </section>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>
