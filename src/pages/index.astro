---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout showFooter={false}>
  <section class="minimal-home" aria-label="欢迎主页">
    <p class="welcome-line">欢迎来到我的网站</p>

    <div class="animation-stage">
      <div class="leaf-motion" role="img" aria-label="循环生长的绿色叶片动画">
        <span class="ring ring-outer"></span>
        <span class="ring ring-middle"></span>
        <span class="ring ring-inner"></span>
        <span class="leaf leaf-one"></span>
        <span class="leaf leaf-two"></span>
        <span class="leaf leaf-three"></span>
        <span class="leaf leaf-four"></span>
        <span class="leaf leaf-five"></span>
        <span class="leaf leaf-six"></span>
        <span class="core"></span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .minimal-home {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: calc(100svh - 5.25rem);
    place-items: center;
    overflow: hidden;
    padding: 5rem 1.25rem;
    background:
      linear-gradient(135deg, rgba(247, 254, 231, 0.96), rgba(236, 253, 245, 0.98) 48%, rgba(245, 251, 242, 0.98)),
      var(--paper);
  }

  .minimal-home::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(120deg, rgba(255, 255, 255, 0.48), transparent 42%),
      repeating-linear-gradient(90deg, rgba(20, 83, 45, 0.045) 0 1px, transparent 1px 4.75rem),
      repeating-linear-gradient(0deg, rgba(20, 83, 45, 0.035) 0 1px, transparent 1px 4.75rem);
    mask-image: linear-gradient(to bottom, transparent, black 16%, black 84%, transparent);
  }

  .welcome-line {
    position: absolute;
    top: 1.35rem;
    left: clamp(1.25rem, 4vw, 3rem);
    z-index: 2;
    margin: 0;
    color: #166534;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .animation-stage {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(74vw, 27rem);
    aspect-ratio: 1;
    place-items: center;
  }

  .leaf-motion {
    position: relative;
    display: grid;
    width: clamp(15rem, 42vw, 24rem);
    aspect-ratio: 1;
    place-items: center;
    animation: leaf-turn 18s linear infinite;
  }

  .ring {
    position: absolute;
    border: 1px solid rgba(21, 128, 61, 0.22);
    border-radius: 999px;
    box-shadow: inset 0 0 2rem rgba(187, 247, 208, 0.16);
    animation: ring-breathe 5.5s ease-in-out infinite;
  }

  .ring-outer {
    inset: 0.2rem;
  }

  .ring-middle {
    inset: 3.1rem;
    animation-delay: -1.6s;
  }

  .ring-inner {
    inset: 6rem;
    animation-delay: -3.2s;
  }

  .leaf {
    --angle: 0deg;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4.2rem;
    height: 7.6rem;
    margin-top: -9.8rem;
    margin-left: -2.1rem;
    border: 1px solid rgba(5, 150, 105, 0.2);
    border-radius: 88% 0 88% 0;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.7), transparent 36%),
      linear-gradient(145deg, rgba(187, 247, 208, 0.95), rgba(16, 185, 129, 0.78) 56%, rgba(21, 128, 61, 0.92));
    box-shadow:
      0 1.1rem 2.2rem rgba(20, 83, 45, 0.12),
      inset 0.35rem 0.35rem 0.8rem rgba(255, 255, 255, 0.38);
    transform: rotate(var(--angle)) translateY(-0.25rem) scale(0.94);
    transform-origin: 50% 9.8rem;
    animation: leaf-breathe 4.8s ease-in-out infinite;
  }

  .leaf::after {
    content: "";
    position: absolute;
    inset: 0.7rem auto 0.7rem 50%;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(6, 78, 59, 0.36), transparent);
    transform: rotate(-34deg);
    transform-origin: bottom;
  }

  .leaf-one {
    --angle: 0deg;
  }

  .leaf-two {
    --angle: 60deg;
    animation-delay: -0.65s;
  }

  .leaf-three {
    --angle: 120deg;
    animation-delay: -1.3s;
  }

  .leaf-four {
    --angle: 180deg;
    animation-delay: -1.95s;
  }

  .leaf-five {
    --angle: 240deg;
    animation-delay: -2.6s;
  }

  .leaf-six {
    --angle: 300deg;
    animation-delay: -3.25s;
  }

  .core {
    position: absolute;
    width: 4.9rem;
    aspect-ratio: 1;
    border: 1px solid rgba(5, 150, 105, 0.35);
    border-radius: 999px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.88), rgba(220, 252, 231, 0.72)),
      #ecfdf5;
    box-shadow:
      0 1rem 2rem rgba(20, 83, 45, 0.16),
      inset 0 0 1.4rem rgba(134, 239, 172, 0.5);
    animation: core-pulse 4.8s ease-in-out infinite;
  }

  @keyframes leaf-turn {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes ring-breathe {
    0%,
    100% {
      opacity: 0.36;
      transform: scale(0.98);
    }

    50% {
      opacity: 0.74;
      transform: scale(1.025);
    }
  }

  @keyframes leaf-breathe {
    0%,
    100% {
      opacity: 0.72;
      transform: rotate(var(--angle)) translateY(-0.15rem) scale(0.92);
    }

    50% {
      opacity: 1;
      transform: rotate(var(--angle)) translateY(-0.95rem) scale(1.04);
    }
  }

  @keyframes core-pulse {
    0%,
    100% {
      transform: scale(0.94);
    }

    50% {
      transform: scale(1.06);
    }
  }

  @media (max-width: 640px) {
    .minimal-home {
      min-height: calc(100svh - 8.5rem);
      padding: 4rem 1rem;
    }

    .animation-stage {
      width: min(82vw, 20rem);
    }

    .leaf-motion {
      width: 16rem;
    }

    .ring-middle {
      inset: 2.2rem;
    }

    .ring-inner {
      inset: 4.4rem;
    }

    .leaf {
      width: 3.2rem;
      height: 6.1rem;
      margin-top: -8.2rem;
      margin-left: -1.6rem;
      transform-origin: 50% 8.2rem;
    }

    .core {
      width: 3.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .leaf-motion,
    .ring,
    .leaf,
    .core {
      animation: none;
    }
  }
</style>
