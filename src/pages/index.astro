---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, getProjects, getPublishedNotes, getPublishedWriting } from "../lib/content";

const selectedArticles = (await getPublishedWriting()).slice(0, 14).map((entry) => ({
  entry,
  type: "技术",
  href: `/writing/${entry.id}/`,
}));
const visibleProjectIds = new Set(["ai-passage-creator", "personal-blog-system"]);
const projects = (await getProjects()).filter((project) => visibleProjectIds.has(project.id));
const writingCount = (await getPublishedWriting()).length;
const noteCount = (await getPublishedNotes()).length;
const totalPosts = writingCount + noteCount;
const daysOnline = 568;
const stats = [
  { value: totalPosts, label: "博客发布" },
  { value: projects.length, label: "项目" },
  { value: `${daysOnline} 天`, label: "网站运行" },
];
---

<BaseLayout>
  <section class="featured-home">
    <div class="page-heading">
      <h1>精选文章</h1>
    </div>

    <div class="home-grid">
      <section class="article-list" aria-label="精选文章列表">
        {
          selectedArticles.map((item, index) => {
            const views = 68 + index * 23 + item.entry.data.title.length;
            const tag = item.entry.data.tags[0] ?? item.type;

            return (
              <article class="article-card">
                <a class="article-link" href={item.href}>
                  <div class="article-head">
                    <span>{item.type}</span>
                    <time datetime={item.entry.data.date.toISOString()}>{formatDate(item.entry.data.date)}</time>
                  </div>
                  <h2>{item.entry.data.title}</h2>
                  <p>{item.entry.data.description}</p>
                  <div class="article-meta" aria-label={`${item.entry.data.title} 元信息`}>
                    <span>{tag}</span>
                    <span>浏览 {views}</span>
                    <span>{formatDate(item.entry.data.date)}</span>
                  </div>
                </a>
              </article>
            );
          })
        }
      </section>

      <aside class="profile-card" aria-label="个人信息卡片">
        <div class="avatar-card">
          <img class="profile-avatar" src="/images/profile-avatar.jpg" alt="小志的头像" width="112" height="112" />
        </div>
        <h2>小志</h2>
        <p class="profile-intro">
          你好，我是小志，欢迎来到我的网站
        </p>
        <p class="profile-intro">
          这里是我分享技术文章、生活点滴的地方。
        </p>
        <p class="profile-intro">
          希望你能在这里收获知识或者好心情。
        </p>
        <div class="profile-stats" aria-label="网站统计">
          {stats.map((stat) => (
            <div>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
        <div class="profile-tags">
          <span>技术写作 {writingCount}</span>
          <span>随笔记录 {noteCount}</span>
        </div>
        <div class="profile-links" aria-label="个人链接">
          <a href="/images/qq-qr.jpg" target="_blank" rel="noopener noreferrer" aria-label="QQ" title="QQ">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3.2c-3.2 0-5.6 2.9-5.6 6.7 0 1.8-.8 3.2-1.7 4.5-.4.6-.1 1.5.6 1.7l1.6.4c.6 1.5 2.3 2.5 4.1 2.7l-.7 1.4h4.1l-.7-1.4c1.8-.2 3.4-1.2 4.1-2.7l1.6-.4c.7-.2 1-.9.6-1.6-.9-1.4-1.7-2.7-1.7-4.6 0-3.8-2.4-6.7-5.6-6.7Z" />
            </svg>
          </a>
          <a href="/images/wechat-qr.png" target="_blank" rel="noopener noreferrer" aria-label="微信" title="微信">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9.8 5.2c-4 0-7.1 2.5-7.1 5.7 0 1.8 1 3.4 2.6 4.4l-.5 1.8 2.2-1c.8.2 1.6.3 2.5.3 3.8 0 7-2.5 7-5.6S13.7 5.2 9.8 5.2Zm-2.3 4.2a.9.9 0 1 1 0-1.8.9.9 0 0 1 0 1.8Zm5 0a.9.9 0 1 1 0-1.8.9.9 0 0 1 0 1.8Z" />
              <path d="M15.5 11.4c3.2 0 5.8 2 5.8 4.6 0 1.3-.7 2.5-1.8 3.3l.4 1.5-1.8-.8c-.7.2-1.4.3-2.1.3-3.2 0-5.7-2-5.7-4.6s2.4-4.3 5.2-4.3Zm-1.8 3.1a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm4 0a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" />
            </svg>
          </a>
          <a href="mailto:1900074789@qq.com" aria-label="邮箱" title="邮箱">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 6.5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Zm1.6 2.2 6.4 4.7 6.4-4.7H5.6Zm-.8 2v5.1h14.4v-5.1l-7.2 5.1-7.2-5.1Z" />
            </svg>
          </a>
          <a href="https://github.com/OpFi" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3.2a8.6 8.6 0 0 0-2.7 16.8c.4.1.5-.2.5-.4v-1.5c-2.1.5-2.6-.9-2.6-.9-.4-.9-.9-1.1-.9-1.1-.7-.5.1-.5.1-.5.8.1 1.3.9 1.3.9.7 1.2 1.9.9 2.4.7.1-.5.3-.9.5-1.1-1.7-.2-3.5-.9-3.5-3.8 0-.8.3-1.5.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8.6-.2 1.3-.3 2-.3s1.4.1 2 .3c1.5-1 2.2-.8 2.2-.8.5 1.1.2 1.9.1 2.1.5.6.8 1.3.8 2.1 0 2.9-1.8 3.6-3.5 3.8.3.3.6.8.6 1.6v2.4c0 .2.1.5.6.4A8.6 8.6 0 0 0 12 3.2Z" />
            </svg>
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .featured-home {
    min-height: 100%;
    padding: 2rem 1.25rem 4rem;
    background:
      linear-gradient(180deg, rgba(246, 252, 244, 0.95), rgba(250, 253, 247, 0.92)),
      linear-gradient(135deg, rgba(220, 252, 231, 0.34), transparent 44%),
      var(--paper);
  }

  .page-heading {
    margin: 0 auto 2rem;
    max-width: 68rem;
    text-align: center;
  }

  .page-heading h1 {
    margin: 0;
    color: #14532d;
    font-size: clamp(2rem, 4.8vw, 3rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.1;
    text-shadow: 0 0.8rem 2rem rgba(20, 83, 45, 0.1);
  }

  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: 1.25rem;
    width: min(100%, 70rem);
    margin: 0 auto;
    align-items: start;
  }

  .article-list {
    display: grid;
    gap: 1rem;
  }

  .article-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(21, 128, 61, 0.16);
    border-radius: 10px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(247, 253, 248, 0.9)),
      #fff;
    box-shadow: 0 16px 38px rgba(20, 83, 45, 0.07);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .article-card:hover {
    border-color: rgba(5, 150, 105, 0.28);
    box-shadow: 0 18px 42px rgba(5, 150, 105, 0.11);
    transform: translateY(-1px);
  }

  .article-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: linear-gradient(180deg, #bbf7d0, #059669);
    opacity: 0.72;
  }

  .article-link {
    display: block;
    padding: 1.25rem 1.35rem 1.1rem;
  }

  .article-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: #047857;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .article-head time {
    color: rgba(23, 53, 40, 0.55);
    font-weight: 600;
    white-space: nowrap;
  }

  .article-card h2 {
    margin: 0.55rem 0 0;
    color: #14532d;
    font-size: clamp(1.1rem, 2vw, 1.28rem);
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1.35;
  }

  .article-card p {
    display: -webkit-box;
    margin: 0.58rem 0 0;
    overflow: hidden;
    color: rgba(23, 53, 40, 0.78);
    font-size: 0.9rem;
    line-height: 1.85;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.78rem;
    color: rgba(23, 53, 40, 0.6);
    font-size: 0.75rem;
  }

  .article-meta span + span::before {
    content: "/";
    margin-right: 0.45rem;
    color: rgba(5, 150, 105, 0.36);
  }

  .profile-card {
    position: sticky;
    top: 1rem;
    border: 1px solid rgba(21, 128, 61, 0.16);
    border-radius: 12px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(247, 253, 248, 0.92)),
      #fff;
    box-shadow: 0 18px 42px rgba(20, 83, 45, 0.08);
    padding: 1.35rem;
    text-align: center;
  }

  .avatar-card {
    width: 6.2rem;
    aspect-ratio: 1;
    margin: 0 auto 1rem;
    border: 1px solid rgba(21, 128, 61, 0.16);
    border-radius: 14px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.8), transparent 46%),
      radial-gradient(circle at 32% 22%, rgba(220, 252, 231, 0.95), transparent 42%),
      linear-gradient(135deg, #bbf7d0, #047857);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 14px 28px rgba(20, 83, 45, 0.12);
    overflow: hidden;
  }

  .profile-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-card h2 {
    margin: 0;
    color: #14532d;
    font-size: 1.05rem;
    font-weight: 850;
    letter-spacing: 0;
  }

  .profile-intro {
    margin: 0.42rem 0 0;
    color: rgba(23, 53, 40, 0.76);
    font-size: 0.84rem;
    line-height: 1.58;
    text-align: left;
  }

  .profile-card h2 + .profile-intro {
    margin-top: 0.72rem;
  }

  .profile-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .profile-stats div {
    border-radius: 9px;
    background: rgba(240, 253, 244, 0.8);
    padding: 0.55rem 0.35rem;
  }

  .profile-stats strong {
    display: block;
    color: #166534;
    font-size: 0.95rem;
    line-height: 1.1;
  }

  .profile-stats span {
    display: block;
    margin-top: 0.2rem;
    color: rgba(23, 53, 40, 0.55);
    font-size: 0.7rem;
  }

  .profile-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 0.95rem;
  }

  .profile-tags span {
    border: 1px solid rgba(5, 150, 105, 0.2);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: #047857;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.28rem 0.62rem;
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
    margin-top: 1.1rem;
  }

  .profile-links a {
    display: grid;
    width: 2.4rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgba(5, 150, 105, 0.28);
    border-radius: 999px;
    background: rgba(240, 253, 244, 0.94);
    color: #14532d;
    box-shadow: 0 0.6rem 1.3rem rgba(20, 83, 45, 0.08);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .profile-links a:hover {
    border-color: rgba(21, 128, 61, 0.34);
    background: rgba(220, 252, 231, 0.72);
    color: #166534;
  }

  .profile-links svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: currentColor;
  }

  .profile-links svg path {
    fill: currentColor;
  }

  @media (max-width: 900px) {
    .featured-home {
      padding-top: 1.6rem;
    }

    .home-grid {
      grid-template-columns: 1fr;
      max-width: 42rem;
    }

    .profile-card {
      position: static;
      order: -1;
    }

  }

  @media (max-width: 520px) {
    .featured-home {
      padding-inline: 0.9rem;
    }

    .article-link {
      padding: 1.1rem 1rem 0.95rem;
    }

    .article-head {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }

    .article-meta span + span::before {
      content: "";
      margin: 0;
    }
  }
</style>
