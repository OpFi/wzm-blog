---
interface Props {
  tags?: string[];
}

const { tags = [] } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li class="rounded-full border border-slate-200 bg-white/70 px-2.5 py-1 text-xs text-slate-600">
          {tag}
        </li>
      ))}
    </ul>
  )
}
